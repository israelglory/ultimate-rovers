{
  "name": "Matchday Navy",
  "color": {
    "night": { "value": "#071341", "use": "Header, hero bands, footer, dark cards" },
    "navy": { "value": "#0E2A8C", "use": "Primary buttons and links on light, player photo panels" },
    "navy-raised": { "value": "#13277A", "use": "Video frames and icon buttons on dark" },
    "navy-soft": { "value": "#1B3AA6", "use": "Image placeholders on navy" },
    "navy-silhouette": { "value": "#2D4CB8", "use": "Player silhouette placeholder" },
    "line-dark": { "value": "#1E3383", "use": "Dividers on dark" },
    "border-dark": { "value": "#3A55B5", "use": "Inputs, outline chips and outline buttons on dark" },
    "cyan": { "value": "#5CE1E6", "use": "Accent, primary action on dark, active nav, focus ring. Never as text on white" },
    "cyan-tint": { "value": "#E3F9FA", "use": "Competition tags, highlighted table row, success panel" },
    "cyan-tint-text": { "value": "#0A3E6B", "use": "Text on cyan-tint" },
    "chalk": { "value": "#F4F7FB", "use": "Page background" },
    "mist": { "value": "#E6ECF6", "use": "Alternate section background, inactive segmented controls" },
    "line": { "value": "#DCE3EF", "use": "Card borders, table rules, image placeholders on light" },
    "line-strong": { "value": "#B8C3D9", "use": "Input borders, dashed placeholders" },
    "white": { "value": "#FFFFFF", "use": "Cards and surfaces" },
    "ink": { "value": "#0A1030", "use": "Body text" },
    "ink-soft": { "value": "#2A3458", "use": "Long-form paragraphs" },
    "slate": { "value": "#4A5578", "use": "Secondary text on light" },
    "mist-text": { "value": "#C3CDEE", "use": "Secondary text on dark" },
    "card-yellow": { "value": "#F2C94C", "use": "Yellow card badge" },
    "card-red": { "value": "#C62828", "use": "Red card badge" }
  },
  "font": {
    "display": { "family": "Big Shoulders Display", "weights": [700, 800, 900], "fallback": "'Arial Narrow', sans-serif", "use": "Headlines, scores, squad numbers, player surnames" },
    "body": { "family": "Archivo", "weights": [400, 500, 600, 700], "fallback": "system-ui, sans-serif", "use": "Everything else" }
  },
  "typeScale": {
    "hero": { "size": "clamp(76px, 12vw, 184px)", "lineHeight": 0.84, "weight": 900, "font": "display" },
    "page-title": { "size": "clamp(56px, 8vw, 104px)", "lineHeight": 0.9, "weight": 900, "font": "display" },
    "section": { "size": "52px", "lineHeight": 1, "weight": 900, "font": "display", "note": "44 to 48px for secondary sections" },
    "card-title": { "size": "28px", "lineHeight": 1, "weight": 800, "font": "display" },
    "lead": { "size": "18px", "lineHeight": 1.6, "weight": 400, "font": "body" },
    "body": { "size": "16px", "lineHeight": 1.55, "weight": 400, "font": "body" },
    "ui": { "size": "15px", "lineHeight": 1.4, "weight": 600, "font": "body" },
    "meta": { "size": "13px", "lineHeight": 1.4, "weight": 400, "font": "body" }
  },
  "space": [4, 8, 12, 16, 24, 32, 48, 64, 80],
  "radius": { "button": "6px", "card": "12px", "feature": "16px", "panel": "20px", "pill": "999px" },
  "layout": { "contentMax": "1280px", "gutter": "24px", "touchTarget": "44px", "headerAccent": "3px solid cyan" }
}
