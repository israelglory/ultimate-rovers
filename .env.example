# Copy to .env for local development. Every variable is documented in README.md.

# Database
DATABASE_URL=postgres://rovers:rovers@127.0.0.1:54329/rovers

# Payload signs auth tokens with this. Use a long random string in production.
PAYLOAD_SECRET=replace-with-a-long-random-string

# Public URL of the site, no trailing slash. Used for canonical URLs, sitemap, ICS and OG images.
SITE_URL=http://localhost:3000

# Where uploads are written when S3 is not configured. Defaults to ./media and ./documents-uploads.
MEDIA_DIR=
DOCUMENTS_DIR=

# Seed placeholder content on boot when the database has no matches and no players.
SEED_ON_EMPTY=false

# Email over SMTP. Leave SMTP_HOST empty to log emails to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Ultimate Rovers

# S3-compatible media storage. Leave S3_BUCKET empty to store uploads on the local volume.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
